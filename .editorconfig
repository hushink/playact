# Project root .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

# Python: PEP 8 uses 4-space indentation
[*.py]
indent_size = 4

# Rust: rustfmt commonly uses 4-space indentation and 100-column max width
[*.rs]
indent_size = 4
max_line_length = 100

# Go: gofmt uses tabs
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

# Makefile requires tabs
[Makefile]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = off